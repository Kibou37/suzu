# ─── Database (MySQL) ───────────────────────────────────────
DATABASE_URL="mysql://suzuki:suzuki@localhost:3306/suzuki"

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Backend (NestJS) ───────────────────────────────────────
NODE_ENV="development"
API_PORT=4000
API_URL="http://localhost:4000"
# Required — the API refuses to start without it (no insecure fallback).
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"
# Set to "true" only if the API sits behind a reverse proxy/load balancer
# that you trust to set X-Forwarded-For correctly. Otherwise rate limiting
# uses the raw socket IP so clients can't spoof it.
TRUST_PROXY=""
# Swagger UI ("/api/docs") is on by default outside production; set to
# "true" to explicitly expose it in production too.
SWAGGER_ENABLED=""
# Seed script refuses to run against NODE_ENV=production unless this is "true".
SEED_ALLOW_PROD=""

# ─── Frontend (Next.js) ─────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
# В Docker SSR: http://backend:4000
API_INTERNAL_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Bitrix24 CRM (E12.1) — insert on prod ──────────────────
# Incoming webhook base, trailing slash OK:
#   https://YOUR.bitrix24.ru/rest/1/xxxxxxxx/
BITRIX24_WEBHOOK_URL=""
# Legacy alias (still read as fallback): CRM_WEBHOOK_URL

# ─── SMS.ru (E6 / E11.1) — insert on prod ───────────────────
SMSRU_API_KEY=""
SMSRU_FROM=""
# When key is empty, OTP is logged. Set to 1 in non-prod to echo code in API:
SMS_DEV_ECHO=""
# Legacy aliases: SMS_API_ID, SMS_FROM

# ─── Email (E6 / forgot password) — Gmail SMTP via nodemailer ───
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
MAIL_FROM=""
MAIL_TO=""

# ─── reCAPTCHA v3 (E6) ──────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""
RECAPTCHA_MIN_SCORE="0.5"

# ─── Google (E12) ───────────────────────────────────────────
# Maps JavaScript API — restrict key by HTTP referrer in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# GA4 Measurement ID (G-XXXX). Empty = analytics disabled.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ─── Showroom 360° (E8) — optional embed / video ────────────
# Prefer editing frontend/public/showroom-tour.json (no rebuild).
NEXT_PUBLIC_SHOWROOM_TOUR_EMBED_URL=""
NEXT_PUBLIC_SHOWROOM_TOUR_VIDEO_URL=""

# ─── Finance rates fallback (E7) ────────────────────────────
FINANCE_CREDIT_RATE_PERCENT="12.9"
FINANCE_LEASING_RATE_PERCENT="9.5"
FINANCE_MIN_DOWN_PERCENT="10"
FINANCE_CURRENCY="USD"

# ─── AI chat agent (E10) ────────────────────────────────────
# With key: OpenAI tool-calling agent (cars/FAQ/finance/CRM).
# Without key: local tool agent still works (heuristics + DB).
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"
CHAT_RATE_LIMIT_PER_MIN="30"
API_RATE_LIMIT_PER_MIN="120"
# Optional on boot: write OpenAPI JSON for handover docs
# SWAGGER_EXPORT_PATH="./docs/api/openapi.json"
