generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum CarCondition {
  NEW
  USED
}

enum Role {
  CUSTOMER
  ADMIN
  CONTENT_MANAGER
  DEALER_MANAGER
}

enum BodyType {
  SEDAN
  SUV
  HATCHBACK
  CROSSOVER
  PICKUP
}

enum Transmission {
  MANUAL
  AUTOMATIC
  CVT
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
}

enum BookingType {
  TEST_DRIVE
  SERVICE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ColorType {
  BODY
  INTERIOR
}

enum VehicleIdentifierType {
  VIN
  CHASSIS
}

enum QuoteContactMethod {
  PHONE
  EMAIL
  EITHER
}

enum QuoteStatus {
  PENDING
  CONTACTED
  CLOSED
}

model User {
  id                    String                  @id @default(cuid())
  email                 String                  @unique
  phone                 String?
  phoneVerifiedAt       DateTime?
  passwordHash          String
  role                  Role                    @default(CUSTOMER)
  firstName             String?
  lastName              String?
  vehicleIdentifierType VehicleIdentifierType?
  vehicleIdentifier     String?
  dealerId              String?
  dealerName            String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  bookings              Booking[]
  configurations        Configuration[]
  quoteRequests         QuoteRequest[]
  reviews               Review[]
}

model Car {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  brand        String       @default("Suzuki")
  condition    CarCondition @default(NEW)
  year         Int
  price        Decimal      @db.Decimal(12, 2)
  mileage      Int          @default(0)
  bodyType     BodyType
  fuelType     FuelType
  transmission Transmission
  trim         String?
  description  String?      @db.Text
  horsepower   Int?
  isFeatured   Boolean      @default(false)
  isOffer      Boolean      @default(false)
  offerLabel   String?
  images       Json         @default("[]")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  variants     CarVariant[]
  bookings     Booking[]
  reviews      Review[]

  @@index([condition, price])
  @@index([bodyType])
}

model CarVariant {
  id             String           @id @default(cuid())
  carId          String
  car            Car              @relation(fields: [carId], references: [id], onDelete: Cascade)
  name           String
  basePrice      Decimal          @db.Decimal(12, 2)
  variantOptions CarVariantOption[]
  configurations Configuration[]

  @@index([carId])
}

model Color {
  id       String    @id @default(cuid())
  name     String
  hexCode  String
  type     ColorType
}

model Option {
  id             String             @id @default(cuid())
  name           String
  description    String?            @db.Text
  price          Decimal            @db.Decimal(12, 2)
  category       String?
  variantOptions CarVariantOption[]
}

model CarVariantOption {
  variantId String
  optionId  String
  variant   CarVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  option    Option     @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([variantId, optionId])
}

model Configuration {
  id              String         @id @default(cuid())
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  variantId       String
  variant         CarVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  bodyColorId     String?
  interiorColorId String?
  selectedOptions Json           @default("[]")
  snapshot        Json           @default("{}")
  totalPrice      Decimal        @db.Decimal(12, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  bookings        Booking[]
  quoteRequests   QuoteRequest[]

  @@index([userId, createdAt])
}

model QuoteRequest {
  id              String             @id @default(cuid())
  status          QuoteStatus        @default(PENDING)
  userId          String?
  user            User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  configurationId String?
  configuration   Configuration?     @relation(fields: [configurationId], references: [id], onDelete: SetNull)
  carSlug         String
  modelName       String
  summary         String             @db.Text
  snapshot        Json               @default("{}")
  totalPrice      Decimal            @db.Decimal(12, 2)
  customerName    String
  customerPhone   String
  customerEmail   String
  notes           String?            @db.Text
  dealerId        String
  dealerName      String
  contactMethod   QuoteContactMethod @default(EITHER)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([configurationId])
}

model Booking {
  id              String         @id @default(cuid())
  type            BookingType
  status          BookingStatus  @default(PENDING)
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  carId           String?
  car             Car?           @relation(fields: [carId], references: [id], onDelete: SetNull)
  configurationId String?
  configuration   Configuration? @relation(fields: [configurationId], references: [id], onDelete: SetNull)
  scheduledAt     DateTime
  customerName    String
  customerPhone   String
  customerEmail   String?
  notes           String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([scheduledAt, type])
  @@index([configurationId])
}

model ServiceSlot {
  id          String      @id @default(cuid())
  startsAt    DateTime
  endsAt      DateTime
  type        BookingType
  maxBookings Int         @default(1)
  isBlocked   Boolean     @default(false)

  @@index([type, startsAt])
  @@unique([startsAt, type])
}

model Review {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  carId       String?
  car         Car?     @relation(fields: [carId], references: [id], onDelete: SetNull)
  authorName  String
  rating      Int
  title       String?
  content     String   @db.Text
  isPublished Boolean  @default(false)
  images      Json     @default("[]")
  videoUrl    String?
  createdAt   DateTime @default(now())
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?   @db.Text
  content     String    @db.Text
  coverImage  String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model FAQ {
  id        String @id @default(cuid())
  question  String
  answer    String @db.Text
  category  String?
  sortOrder Int    @default(0)
}

model Promotion {
  id          String    @id @default(cuid())
  title       String
  subtitle    String?
  description String?   @db.Text
  image       String?
  linkUrl     String?
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean   @default(true)
}

/// Homepage hero slides — edited in /admin/banners (desktop + mobile uploads)
model HomeBanner {
  id           String  @id @default(cuid())
  title        String
  subtitle     String?
  description  String? @db.Text
  linkUrl      String?
  linkLabel    String?
  imageDesktop String
  imageMobile  String?
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Uploaded images registry for admin media library / picker
model MediaAsset {
  id           String   @id @default(cuid())
  url          String
  filename     String
  originalName String?
  folder       String
  mimeType     String
  size         Int
  alt          String?
  createdAt    DateTime @default(now())

  @@index([folder])
  @@index([createdAt])
}
